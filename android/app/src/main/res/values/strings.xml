<resources>
  <string name="app_name">HDR Bridge</string>
  <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:colorAccent">#356FA8</item>
    <item name="android:windowBackground">@color/app_background</item>
    <item name="android:statusBarColor">@color/app_background</item>
    <item name="android:navigationBarColor">@color/app_background</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:buttonStyle">@style/FlatButton</item>
  </style>
  <style name="FlatButton" parent="android:style/Widget.Material.Button">
    <item name="android:background">@drawable/button_surface</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:elevation">0dp</item>
    <item name="android:minHeight">36dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">@color/button_text</item>
  </style>
</resources>
