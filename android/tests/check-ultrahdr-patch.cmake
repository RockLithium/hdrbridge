# Run with cmake -P android/tests/check-ultrahdr-patch.cmake from the repository root.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(source "${root}/.tools/libultrahdr")
set(fixture "${root}/android/build/ultrahdr-patch-test")
file(MAKE_DIRECTORY "${fixture}/lib/src/dsp/arm")
foreach(name ultrahdr_api.cpp jpegdecoderhelper.cpp)
  file(COPY "${source}/lib/src/${name}" DESTINATION "${fixture}/lib/src")
endforeach()
file(COPY "${source}/lib/src/dsp/arm/gainmapmath_neon.cpp" DESTINATION "${fixture}/lib/src/dsp/arm")
set(path "${fixture}/lib/src/dsp/arm/gainmapmath_neon.cpp")
file(READ "${path}" input)
set(old "    } else if (src->cg == UHDR_CG_BT_2100) {\n      coeffs_ptr = kRgbDispP3ToYuv_coeffs_neon;\n    } else if (src->cg == UHDR_CG_DISPLAY_P3) {\n      coeffs_ptr = kRgb2100ToYuv_coeffs_neon;")
set(fixed "    } else if (src->cg == UHDR_CG_BT_2100) {\n      coeffs_ptr = kRgb2100ToYuv_coeffs_neon;\n    } else if (src->cg == UHDR_CG_DISPLAY_P3) {\n      coeffs_ptr = kRgbDispP3ToYuv_coeffs_neon;")
set(old_p3 "// RGB Display P3 -> Yuv Display P3\n// Y = 0.2289746 * R + 0.6917385 * G + 0.0792869 * B\n// U = -0.124346335 * R + -0.375653665 * G + 0.5 * B\n// V = 0.5 * R + -0.448583471 * G + -0.051416529 * B\nALIGNED(16)\nconst uint16_t kRgbDispP3ToYuv_coeffs_neon[8] = {3752, 11333, 1299, 2037, 6155, 8192, 7350, 842};")
set(previous_p3 "// RGB Display P3 -> JPEG YCbCr (BT.601 luma, matching scalar p3RgbToYuv)\n// Q14 coefficients, with complementary pairs summing to 8192.\nALIGNED(16)\nconst uint16_t kRgbDispP3ToYuv_coeffs_neon[8] = {4899, 9617, 1868, 2765, 5427, 8192, 6860, 1332};")
set(fixed_p3 "// RGB Display P3 -> JPEG YCbCr (BT.601, matching scalar p3RgbToYuv)\n// Y = 0.299 * R + 0.587 * G + 0.114 * B\n// U = (B - Y) / 1.772\n// V = (R - Y) / 1.402\n// Q14 coefficients, with complementary pairs summing to 8192.\nALIGNED(16)\nconst uint16_t kRgbDispP3ToYuv_coeffs_neon[8] = {4899, 9617, 1868, 2765, 5427, 8192, 6860, 1332};")
string(REPLACE "${fixed}" "${old}" input "${input}")
string(REPLACE "${fixed_p3}" "${old_p3}" input "${input}")
string(REPLACE "${previous_p3}" "${old_p3}" input "${input}")
string(FIND "${input}" "${old}" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "Test fixture does not contain a recognized ARM lookup")
endif()
string(FIND "${input}" "${old_p3}" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "Test fixture does not contain recognized ARM P3 coefficients")
endif()
file(WRITE "${path}" "${input}")
string(REPLACE "${old}" "${fixed}" expected "${input}")
string(REPLACE "${old_p3}" "${fixed_p3}" expected "${expected}")
include("${root}/cmake/PatchUltraHdr.cmake")
hdrbridge_patch_ultrahdr("${fixture}")
file(READ "${path}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "ARM lookup patch did not produce the expected source")
endif()
file(SHA256 "${path}" first_hash)
hdrbridge_patch_ultrahdr("${fixture}")
file(SHA256 "${path}" second_hash)
if(NOT first_hash STREQUAL second_hash)
  message(FATAL_ERROR "ARM lookup patch is not idempotent")
endif()
string(REPLACE "${fixed_p3}" "${previous_p3}" previous "${actual}")
file(WRITE "${path}" "${previous}")
hdrbridge_patch_ultrahdr("${fixture}")
file(READ "${path}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Previously patched ARM coefficients did not update")
endif()
message(STATUS "Ultra HDR ARM lookup patch passed")
