set(UHDR_MAX_DIMENSION 65500 CACHE STRING "Maximum Ultra HDR JPEG dimension permitted by JPEG" FORCE)

function(hdrbridge_patch_ultrahdr source_dir)
  file(COPY "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../core/src/uhdr_limits.h" DESTINATION "${source_dir}/lib/src")
  set(path "${source_dir}/lib/src/ultrahdr_api.cpp")
  file(READ "${path}" contents)
  set(original "${contents}")
  set(old_guard "  } else if (!hdrbridge_uhdr_area_safe(img->w, img->h)) {\n    status.error_code = UHDR_CODEC_INVALID_PARAM;\n    status.has_detail = 1;\n    snprintf(status.detail, sizeof status.detail, \"image exceeds safe pixel count\");\n  } else if (img->fmt == UHDR_IMG_FMT_24bppYCbCrP010) {")
  string(REPLACE "${old_guard}" "  } else if (img->fmt == UHDR_IMG_FMT_24bppYCbCrP010) {" contents "${contents}")
  set(inc "#include \"ultrahdr_api.h\"\n#include \"uhdr_limits.h\"")
  string(FIND "${contents}" "${inc}" pos)
  if(pos EQUAL -1)
    string(REPLACE "#include \"ultrahdr_api.h\"" "${inc}" contents "${contents}")
  endif()
  set(old "(std::max)((64u * 1024), hdr_raw_entry->w * hdr_raw_entry->h * 3 * 2)")
  set(intermediate "(std::max)(size_t{64} * 1024, size_t{hdr_raw_entry->w} * hdr_raw_entry->h * 3 * 2)")
  set(new "(std::max)(size_t{64} * 1024, hdrbridge_uhdr_mul(hdrbridge_uhdr_mul(hdr_raw_entry->w, hdr_raw_entry->h), 6))")
  string(REPLACE "${old}" "${new}" contents "${contents}")
  string(REPLACE "${intermediate}" "${new}" contents "${contents}")
  string(REPLACE "2 * (base_entry->data_sz + gainmap_entry->data_sz)" "hdrbridge_uhdr_mul(2, hdrbridge_uhdr_add(base_entry->data_sz, gainmap_entry->data_sz))" contents "${contents}")
  string(FIND "${contents}" "${new}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "Unrecognized libultrahdr compressed allocation in ${path}")
  endif()
  string(REPLACE "bpp * aligned_width * h_" "hdrbridge_uhdr_mul(hdrbridge_uhdr_mul(bpp, aligned_width), h_)" contents "${contents}")
  string(REPLACE "2 /* planes */ * bpp * (aligned_width / 2) * (h_ / 2)" "hdrbridge_uhdr_mul(hdrbridge_uhdr_mul(2 * bpp, aligned_width / 2), h_ / 2)" contents "${contents}")
  string(REPLACE "bpp * (aligned_width / 2) * (h_ / 2)" "hdrbridge_uhdr_mul(hdrbridge_uhdr_mul(bpp, aligned_width / 2), h_ / 2)" contents "${contents}")
  string(REPLACE "plane_1_sz + plane_2_sz + plane_3_sz" "hdrbridge_uhdr_add(hdrbridge_uhdr_add(plane_1_sz, plane_2_sz), plane_3_sz)" contents "${contents}")
  string(FIND "${contents}" "hdrbridge_uhdr_add(hdrbridge_uhdr_add(plane_1_sz" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "Unrecognized libultrahdr raw allocation in ${path}")
  endif()
  if(NOT contents STREQUAL original)
    file(WRITE "${path}" "${contents}")
  endif()

  set(path "${source_dir}/lib/src/jpegdecoderhelper.cpp")
  file(READ "${path}" contents)
  set(original "${contents}")
  set(old_guard "    if (!hdrbridge_uhdr_area_safe(cinfo.image_width, cinfo.image_height)) {\n      status.error_code = UHDR_CODEC_ERROR;\n      status.has_detail = 1;\n      snprintf(status.detail, sizeof status.detail, \"image exceeds safe pixel count\");\n      jpeg_destroy_decompress(&cinfo);\n      return status;\n    }\n")
  string(REPLACE "${old_guard}" "" contents "${contents}")
  set(inc "#include \"ultrahdr/jpegdecoderhelper.h\"\n#include \"uhdr_limits.h\"")
  string(FIND "${contents}" "${inc}" pos)
  if(pos EQUAL -1)
    string(REPLACE "#include \"ultrahdr/jpegdecoderhelper.h\"" "${inc}" contents "${contents}")
  endif()
  string(REPLACE "(size_t)mPlaneHStride[0] * mPlaneVStride[0] * 4" "hdrbridge_uhdr_mul(hdrbridge_uhdr_mul(mPlaneHStride[0], mPlaneVStride[0]), 4)" contents "${contents}")
  string(REPLACE "(size_t)mPlaneHStride[0] * mPlaneVStride[0] * 3" "hdrbridge_uhdr_mul(hdrbridge_uhdr_mul(mPlaneHStride[0], mPlaneVStride[0]), 3)" contents "${contents}")
  string(REPLACE "size += (size_t)mPlaneHStride[i] * mPlaneVStride[i];" "size = hdrbridge_uhdr_add(size, hdrbridge_uhdr_mul(mPlaneHStride[i], mPlaneVStride[i]));" contents "${contents}")
  string(REPLACE "for (int i = 0, plane_offset = 0; i < cinfo->num_components; i++) {" "size_t plane_offset = 0;\n  for (int i = 0; i < cinfo->num_components; i++) {" contents "${contents}")
  string(REPLACE "plane_offset += mPlaneHStride[i] * mPlaneVStride[i];" "plane_offset = hdrbridge_uhdr_add(plane_offset, hdrbridge_uhdr_mul(mPlaneHStride[i], mPlaneVStride[i]));" contents "${contents}")
  string(FIND "${contents}" "hdrbridge_uhdr_add(size, hdrbridge_uhdr_mul" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "Unrecognized libultrahdr JPEG allocation in ${path}")
  endif()
  if(NOT contents STREQUAL original)
    file(WRITE "${path}" "${contents}")
  endif()
endfunction()

if(DEFINED HDRBRIDGE_UHDR_SOURCE)
  hdrbridge_patch_ultrahdr("${HDRBRIDGE_UHDR_SOURCE}")
endif()
