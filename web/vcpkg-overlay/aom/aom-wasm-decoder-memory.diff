diff --git a/aom_scale/generic/yv12config.c b/aom_scale/generic/yv12config.c
index 1111111..2222222 100644
--- a/aom_scale/generic/yv12config.c
+++ b/aom_scale/generic/yv12config.c
@@ -91,7 +91,11 @@ static int realloc_frame_buffer_aligned(
     // The decoder may allocate REF_FRAMES frame buffers in the frame buffer
     // pool. Bound the total amount of allocated memory as if these REF_FRAMES
     // frame buffers were allocated in a single allocation.
+#if defined(__EMSCRIPTEN__)
+    if (alloc_size > (uint64_t)384 * 1024 * 1024)
+#else
     if (alloc_size > AOM_MAX_ALLOCABLE_MEMORY / REF_FRAMES)
+#endif
       return AOM_CODEC_MEM_ERROR;
 #endif
 
