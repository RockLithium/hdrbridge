-static void wait_for_jobs(std::deque<std::future<Error> >* jobs) {
+#if defined(__EMSCRIPTEN_PTHREADS__)
+// Join each tile thread synchronously so Emscripten can recycle its worker
+// before the next tile is dispatched, even while the calling worker is busy.
+struct GridJob {
+  std::future<Error> result;
+  std::thread thread;
+  explicit GridJob(std::packaged_task<Error()>&& task)
+    : result(task.get_future()), thread(std::move(task)) {}
+  GridJob(GridJob&&) = default;
+  ~GridJob() { if (thread.joinable()) thread.join(); }
+  Error get() { if (thread.joinable()) thread.join(); return result.get(); }
+};
+#else
+using GridJob = std::future<Error>;
+#endif
+static void wait_for_jobs(std::deque<GridJob>* jobs) {
   if (jobs->empty()) {
     return;
   }
